# ---- VaanVizhi API configuration (copy to .env) ----
PORT=4000
# Change in any shared deployment. Signs DEMO session tokens.
SESSION_SECRET=change-me-to-a-long-random-string
# DEMO_MODE=true enables one-click demo login and demo reset. Set false in production.
DEMO_MODE=true
CORS_ORIGIN=*
# SQLite file used for development persistence
DATABASE_FILE=./data/vaanvizhi.db
# Require a different officer to approve an alert than the one who drafted it
REQUIRE_SECOND_APPROVER=false

# ---- AI (optional). Without a key, deterministic templates + rule-based assistant are used ----
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# ---- SMS (optional). Default: simulator (records SIMULATED, never "delivered") ----
SMS_PROVIDER=simulator
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Safety latch — must be true AND recipient must have SMS consent for a real SMS to be sent
SMS_ALLOW_REAL_SEND=false

# ---- Routing (optional). Public OSRM demo server: light, non-commercial use only. Self-host for production ----
OSRM_URL=https://router.project-osrm.org

# ---- Official warning feed (optional). Only set to a CAP/RSS feed you have confirmed permission to use ----
CAP_FEED_URL=
